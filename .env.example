# Environment Configuration

# Local dev DB (use: uv run scripts/run_local_DB.py)
DATABASE_URL="mysql+pymysql://root:rootpassword@127.0.0.1:3306/scores-local"

# google stuff
GOOGLE_CLIENT_ID=app_client_id_here
GOOGLE_CLIENT_SECRET=app_client_secret_here

# attendance stuff
JWT_SECRET=

# certificate stuff
CERTIFICATE_API_URL=http://localhost:8000

# email sending -- audit-logging only, no AWS creds needed here (send-certificates owns those)
SES_FROM_ADDRESS=certificates@gdg-q.com

# leaderboard/member app cache reset
MEMBER_APP_URL=http://localhost:3000
MEMBER_APP_REVALIDATE_SECRET=your_shared_secret_here

# clerk stuff
CLERK_JWKS_URL=

# error tracking (optional - Sentry no-ops if unset)
SENTRY_DSN=
